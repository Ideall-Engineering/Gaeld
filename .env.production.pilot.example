# Compose
GAELD_IMAGE_TAG=7ca5518
APP_PORT=8088

# Application
APP_NAME="Gäld"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_AVAILABLE_LOCALES=en,fr,de,it

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gaeld
DB_USERNAME=gaeld
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_SSLMODE=prefer

# Redis, cache, sessions and queues
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=gaeld_pilot_database_
REDIS_QUEUE_RETRY_AFTER=900

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Leave SESSION_DOMAIN unset for localhost access.

# Local HTTP access only
TRUSTED_PROXIES=
FORCE_HTTPS=false
CORS_ALLOWED_ORIGINS=http://localhost:8088
SANCTUM_STATEFUL_DOMAINS=localhost:8088

# Passkeys on localhost
WEBAUTHN_NAME="Gäld"
WEBAUTHN_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8088

# E-mail is written to the application log during the pilot
MAIL_MAILER=log
MAIL_FROM_ADDRESS=gaeld@localhost.test
MAIL_FROM_NAME="Gäld"

# Database-backed search; no Meilisearch container in the pilot
SCOUT_DRIVER=database

# OCR
TESSERACT_BINARY=/usr/bin/tesseract
TESSERACT_LANG=deu+fra+eng
OCR_DAILY_LIMIT=3

# Community/self-hosted feature flags
FEATURE_SAAS=false
FEATURE_BANK_SYNC=false
FEATURE_AUTOMATION=false
FEATURE_MULTI_CURRENCY=false
FEATURE_API_ACCESS=false
FEATURE_AUTO_RECONCILIATION=false
FEATURE_RULE_ENGINE=false
FEATURE_ADVANCED_PERMISSIONS=false

# Accounting defaults
ACCOUNTING_CURRENCY=CHF
FISCAL_YEAR_START=01-01

# Horizon and plugins
HORIZON_NAME=gaeld-pilot
HORIZON_PREFIX=gaeld_pilot_horizon:
PLUGINS_ENABLED=true
ACTIVITY_LOGGER_ENABLED=true
SANCTUM_TOKEN_EXPIRATION=10080

# Optional integrations remain disabled for the pilot
DOCS_BASE_URL=https://docs.gaeld.ch
SCHEDULE_HEARTBEAT_URL=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
GTM_ID=
SLACK_HORIZON_WEBHOOK=

# Entrypoint behaviour
GAELD_CACHE_CONFIG=true
